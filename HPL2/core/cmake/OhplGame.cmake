# Game executables: the game code is a STATIC library, rust/game links it and owns main().
# CMake writes the link line (one argument per line) to <build>/ohpl-link/<bin>.link for rust/game/build.rs.

function(ohpl_link_closure out_libs out_targets)
	set(todo ${ARGN})
	set(seen "")
	set(libs "")
	set(targets "")
	while(todo)
		list(POP_FRONT todo t)
		if(t MATCHES "^\\$<LINK_ONLY:(.*)>$")
			set(t "${CMAKE_MATCH_1}")
		endif()
		if("${t}" STREQUAL "" OR "${t}" IN_LIST seen OR "${t}" STREQUAL "ohpl_rust")
			continue()
		endif()
		list(APPEND seen "${t}")
		if(TARGET "${t}")
			get_target_property(type "${t}" TYPE)
			get_target_property(imported "${t}" IMPORTED)
			if(NOT type STREQUAL "INTERFACE_LIBRARY")
				list(APPEND libs "$<TARGET_LINKER_FILE:${t}>")
				if(NOT imported)
					list(APPEND targets "${t}")
				endif()
			endif()
			get_target_property(iface "${t}" INTERFACE_LINK_LIBRARIES)
			if(iface)
				list(APPEND todo ${iface})
			endif()
			if(NOT imported AND NOT type STREQUAL "INTERFACE_LIBRARY")
				get_target_property(priv "${t}" LINK_LIBRARIES)
				if(priv)
					list(APPEND todo ${priv})
				endif()
			endif()
		elseif("${t}" MATCHES "^-" OR "${t}" MATCHES "^\\$<" OR IS_ABSOLUTE "${t}")
			list(APPEND libs "${t}")
		else()
			list(APPEND libs "-l${t}")
		endif()
	endwhile()
	set(${out_libs} "${libs}" PARENT_SCOPE)
	set(${out_targets} "${targets}" PARENT_SCOPE)
endfunction()

# Imported targets are directory scoped: resolve the engine link line here, in the scope of HPL2.
function(ohpl_link_manifest)
	ohpl_link_closure(closure deps HPL2)
	list(JOIN closure "\n" lines)
	file(GENERATE OUTPUT ${CMAKE_BINARY_DIR}/ohpl-link/common.link CONTENT "${lines}\n-Wl,-rpath,$ORIGIN/lib64\n")
	set_property(GLOBAL PROPERTY OHPL_LINK_DEPS "${deps}")
endfunction()

# ohpl_game(<Name> <bin>): target <Name> builds <bin> from rust/game against the static library <Name>Game
function(ohpl_game name bin)
	get_property(rust_dir GLOBAL PROPERTY OHPL_RUST_DIR)
	get_property(rust_target GLOBAL PROPERTY OHPL_RUST_TARGET)
	get_property(rust_profile GLOBAL PROPERTY OHPL_RUST_PROFILE)
	get_property(rust_out GLOBAL PROPERTY OHPL_RUST_OUT)
	get_property(suffix GLOBAL PROPERTY OHPL_EXE_SUFFIX)
	get_property(cargo GLOBAL PROPERTY OHPL_CARGO)
	set(lib ${name}Game)
	get_property(deps GLOBAL PROPERTY OHPL_LINK_DEPS)
	set(link_dir ${CMAKE_BINARY_DIR}/ohpl-link)
	file(GENERATE OUTPUT ${link_dir}/${bin}.link CONTENT
		"-Wl,--whole-archive\n$<TARGET_FILE:${lib}>\n-Wl,--no-whole-archive\n")
	add_custom_target(${name} ALL
		COMMAND ${CMAKE_COMMAND} -E env OHPL_LINK_MANIFEST_DIR=${link_dir}
			${cargo} build --offline --locked --profile ${rust_profile} --target-dir ${rust_target} -p ohpl-game --bin ${bin}
		COMMAND ${CMAKE_COMMAND} -E copy_if_different ${rust_target}/${rust_out}/${bin} ${EXECUTABLE_OUTPUT_PATH}/${name}${suffix}
		WORKING_DIRECTORY ${rust_dir}
		USES_TERMINAL)
	add_dependencies(${name} ${lib} ${deps} ohpl_rust_build)
endfunction()
